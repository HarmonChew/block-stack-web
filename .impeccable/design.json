    "shadows": [],
    "motion": [
      {
        "name": "ease-expo-out",
        "value": "cubic-bezier(0.16, 1, 0.3, 1)",
        "purpose": "Eased layout motion: screen slides, dialog drop-in, count-in, tally rows, cursor slide-in, stat bump."
      },
      {
        "name": "step-pixel",
        "value": "steps(1)",
        "purpose": "Anything built of pixels switches on and off: cursor nudge (0.8s loop), PRESS START blink (1.06s), level-cell flash (0.5s), Tetris flash (0.36s), shake (0.28s), NEW BEST blink (0.5s x 6)."
      },
      {
        "name": "screen-slide",
        "value": "240ms ease-expo-out, translateX(40px), forward right-to-left, back left-to-right",
        "purpose": "Menu-to-menu steps."
      },
      {
        "name": "block-wipe",
        "value": "cover 300ms (stack rises, 44px blocks, 32px under 640px), white flash and swap, reveal 320ms (rows clear from the centre in 5 steps)",
        "purpose": "Signature screen change into and out of the match, and from the title."
      },
      {
        "name": "palette-shift",
        "value": "0.6s ease on --ground, --pa, --pb (registered @property)",
        "purpose": "Level-up and screen-to-screen palette change."
      },
      {
        "name": "logo-build",
        "value": "pieces fall 340ms each, 55ms stagger, lowest first; ARENA band opens from the centre 0.5s; palette cycles every 3.5s with a 600ms diagonal sweep",
        "purpose": "Title assembly and idle recolour."
      },
      {
        "name": "line-clear",
        "value": "columns removed from the centre in steps of 4 frames",
        "purpose": "Board clears, with a Tetris flash alternating per step."
      },
      {
        "name": "top-out-sweep",
        "value": "800ms, dead-stack grey from the top row down",
        "purpose": "Game over on a board."
      },
      {
        "name": "count-in",
        "value": "320ms scale 1.9 to 1 with fade",
        "purpose": "Countdown numbers."
      },
      {
        "name": "pop-rise",
        "value": "1.4s, rises 140% while fading, 0.5 to 1 scale at start",
        "purpose": "Line and level pop text over a well."
      },
      {
        "name": "score-roll",
        "value": "700ms cubic ease-out count-up (result); live score eases at 9x per second",
        "purpose": "Result tally and HUD score."
      },
      {
        "name": "block-rain",
        "value": "90 palette blocks, gravity 0.25, 3s with 0.6s fade",
        "purpose": "Win celebration."
      },
      {
        "name": "ground-drift",
        "value": "40s linear, tile scrolls 160 pixel units downward; off in matches",
        "purpose": "Idle life behind menus."
      },
      {
        "name": "press",
        "value": "translateY(var(--px)) on :active",
        "purpose": "One-pixel press on icon buttons, pads and discs."
      },
      {
        "name": "reduced-motion",
        "value": "prefers-reduced-motion: reduce",
        "purpose": "Drift, cursor nudge, blink, cell flash and shake stop; slides, dialog, tally, count-in and bump become 0.16s fades; wipe, block rain and palette cycling are skipped; Tetris flash shortens to 0.2s."
      }
    ],
