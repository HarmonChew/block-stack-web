      "description": "The one action a screen exists for: a notched frame filled with Deep A (--pd, ink passes 5.2:1 on every palette), ink arrow.",
      "html": "<button class=\"ds-primary cur\" type=\"button\">START</button>",
      "css": ".ds-primary{position:relative;padding:10px 18px 10px calc(var(--px,3px)*10);font:400 16px/1.7 'Press Start 2P',ui-monospace,monospace;letter-spacing:.04em;color:var(--ink,#f7f4ea);cursor:pointer;border:calc(var(--px,3px)*3) solid transparent;border-image:var(--frame,url(\"data:image/svg+xml,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20width%3D'9'%20height%3D'9'%20viewBox%3D'0%200%209%209'%20shape-rendering%3D'crispEdges'%3E%3Cpath%20fill%3D'%233b6cf6'%20d%3D'M1%200h7v1H1zM0%201h1v7H0zM8%201h1v7H8zM1%208h7v1H1z'%2F%3E%3Cpath%20fill%3D'%23f7f4ea'%20d%3D'M1%201h7v1H1zM1%202h1v5H1zM7%202h1v5H7zM1%207h7v1H1z'%2F%3E%3Cpath%20fill%3D'%233b6cf6'%20d%3D'M2%202h5v1H2zM2%203h1v3H2zM6%203h1v3H6zM2%206h5v1H2z'%2F%3E%3Crect%20x%3D'3'%20y%3D'3'%20width%3D'3'%20height%3D'3'%20fill%3D'%2305060a'%20fill-opacity%3D'.92'%2F%3E%3C%2Fsvg%3E\")) 3 / calc(var(--px,3px)*3) stretch;background:var(--pd,#2a4aa6) padding-box;}.ds-primary::before{content:\"\";position:absolute;left:calc(var(--px,3px)*2);top:11px;width:calc(var(--px,3px)*5);height:calc(var(--px,3px)*7);background:var(--ink,#f7f4ea);-webkit-mask:url(\"data:image/svg+xml,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20width%3D'5'%20height%3D'7'%20viewBox%3D'0%200%205%207'%20shape-rendering%3D'crispEdges'%3E%3Cpath%20d%3D'M0%200h1v7H0zM1%201h1v5H1zM2%202h1v3H2zM3%203h1v1H3z'%2F%3E%3C%2Fsvg%3E\") no-repeat center/contain;mask:url(\"data:image/svg+xml,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20width%3D'5'%20height%3D'7'%20viewBox%3D'0%200%205%207'%20shape-rendering%3D'crispEdges'%3E%3Cpath%20d%3D'M0%200h1v7H0zM1%201h1v5H1zM2%202h1v3H2zM3%203h1v1H3z'%2F%3E%3C%2Fsvg%3E\") no-repeat center/contain;opacity:0;}.ds-primary:hover::before,.ds-primary:focus-visible::before,.ds-primary.cur::before{opacity:1;animation:ds-nudge2 .8s steps(1) infinite .2s;}.ds-primary:active{transform:translateY(var(--px,3px));}@keyframes ds-nudge2{50%{translate:var(--px,3px) 0;}}@media (prefers-reduced-motion:reduce){.ds-primary::before{animation:none!important;}}"
    },
    {
      "name": "Level cell",
      "kind": "custom",
      "refersTo": "level-cell",
      "description": "A solo-level tile previewing its own palette in three chips; the current cell outlines in B and flashes.",
      "html": "<div style=\"display:flex;gap:8px\"><div class=\"ds-lv\" style=\"--ca:#3b6cf6;--cb:#f5a524\">7<span class=\"ds-chips\"><i></i><i></i><i></i></span></div><div class=\"ds-lv cur\" style=\"--ca:#4f55e0;--cb:#ff7ac1\">8<span class=\"ds-chips\"><i></i><i></i><i></i></span><small><svg class=\"ds-icon\" viewBox=\"0 0 7 7\" width=\"21\" height=\"21\" fill=\"currentColor\" shape-rendering=\"crispEdges\" aria-hidden=\"true\"><rect x=\"3\" y=\"0\" width=\"1\" height=\"1\"/><rect x=\"2\" y=\"1\" width=\"3\" height=\"1\"/><rect x=\"0\" y=\"2\" width=\"7\" height=\"1\"/><rect x=\"1\" y=\"3\" width=\"5\" height=\"1\"/><rect x=\"2\" y=\"4\" width=\"3\" height=\"1\"/><rect x=\"1\" y=\"5\" width=\"2\" height=\"1\"/><rect x=\"4\" y=\"5\" width=\"2\" height=\"1\"/><rect x=\"0\" y=\"6\" width=\"2\" height=\"1\"/><rect x=\"5\" y=\"6\" width=\"2\" height=\"1\"/></svg></small></div></div>",
      "css": ".ds-lv{position:relative;display:flex;flex-direction:column;align-items:center;gap:8px;width:72px;padding:12px 4px 10px;font:400 16px/1.7 'Press Start 2P',ui-monospace,monospace;color:var(--ink,#f7f4ea);background:rgb(5 6 10/.6);outline:var(--px,3px) solid rgb(247 244 234/.12);outline-offset:calc(var(--px,3px)*-1);cursor:pointer;}.ds-lv:hover{outline-color:rgb(247 244 234/.4);}.ds-chips{display:flex;gap:var(--px,3px);}.ds-chips i{width:calc(var(--px,3px)*4);height:calc(var(--px,3px)*4);background:var(--ca);}.ds-chips i:first-child{background:var(--ink,#f7f4ea);box-shadow:inset 0 0 0 var(--px,3px) var(--ca);}.ds-chips i:last-child{background:var(--cb);}.ds-lv.cur{outline:var(--px,3px) solid var(--cb);color:var(--cb);background:rgb(247 244 234/.06);animation:ds-flash .5s steps(1) infinite;}@keyframes ds-flash{50%{outline-color:var(--ink,#f7f4ea);}}.ds-lv small{position:absolute;top:5px;right:5px;color:var(--cb);}.ds-lv small .ds-icon{width:calc(var(--px,3px)*3);height:auto;display:block;}@media (prefers-reduced-motion:reduce){.ds-lv.cur{animation:none;}}"
    },
    {
      "name": "Icon button",
      "kind": "button",
      "refersTo": "icon-button",
      "description": "A 44px framed pixel-icon button for back, pause and sound; text turns B on hover and sinks a pixel on press.",
      "html": "<button class=\"ds-icon-btn\" type=\"button\" aria-label=\"Back\"><svg class=\"ds-icon\" viewBox=\"0 0 7 7\" width=\"21\" height=\"21\" fill=\"currentColor\" shape-rendering=\"crispEdges\" aria-hidden=\"true\"><rect x=\"3\" y=\"0\" width=\"1\" height=\"1\"/><rect x=\"2\" y=\"1\" width=\"2\" height=\"1\"/><rect x=\"1\" y=\"2\" width=\"6\" height=\"1\"/><rect x=\"0\" y=\"3\" width=\"7\" height=\"1\"/><rect x=\"1\" y=\"4\" width=\"6\" height=\"1\"/><rect x=\"2\" y=\"5\" width=\"2\" height=\"1\"/><rect x=\"3\" y=\"6\" width=\"1\" height=\"1\"/></svg></button> <button class=\"ds-icon-btn\" type=\"button\" aria-label=\"Pause\"><svg class=\"ds-icon\" viewBox=\"0 0 5 7\" width=\"15\" height=\"21\" fill=\"currentColor\" shape-rendering=\"crispEdges\" aria-hidden=\"true\"><rect x=\"0\" y=\"0\" width=\"2\" height=\"1\"/><rect x=\"3\" y=\"0\" width=\"2\" height=\"1\"/><rect x=\"0\" y=\"1\" width=\"2\" height=\"1\"/><rect x=\"3\" y=\"1\" width=\"2\" height=\"1\"/><rect x=\"0\" y=\"2\" width=\"2\" height=\"1\"/><rect x=\"3\" y=\"2\" width=\"2\" height=\"1\"/><rect x=\"0\" y=\"3\" width=\"2\" height=\"1\"/><rect x=\"3\" y=\"3\" width=\"2\" height=\"1\"/><rect x=\"0\" y=\"4\" width=\"2\" height=\"1\"/><rect x=\"3\" y=\"4\" width=\"2\" height=\"1\"/><rect x=\"0\" y=\"5\" width=\"2\" height=\"1\"/><rect x=\"3\" y=\"5\" width=\"2\" height=\"1\"/><rect x=\"0\" y=\"6\" width=\"2\" height=\"1\"/><rect x=\"3\" y=\"6\" width=\"2\" height=\"1\"/></svg></button>",
      "css": ".ds-icon-btn{border:calc(var(--px,3px)*3) solid transparent;border-image:var(--frame,url(\"data:image/svg+xml,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20width%3D'9'%20height%3D'9'%20viewBox%3D'0%200%209%209'%20shape-rendering%3D'crispEdges'%3E%3Cpath%20fill%3D'%233b6cf6'%20d%3D'M1%200h7v1H1zM0%201h1v7H0zM8%201h1v7H8zM1%208h7v1H1z'%2F%3E%3Cpath%20fill%3D'%23f7f4ea'%20d%3D'M1%201h7v1H1zM1%202h1v5H1zM7%202h1v5H7zM1%207h7v1H1z'%2F%3E%3Cpath%20fill%3D'%233b6cf6'%20d%3D'M2%202h5v1H2zM2%203h1v3H2zM6%203h1v3H6zM2%206h5v1H2z'%2F%3E%3Crect%20x%3D'3'%20y%3D'3'%20width%3D'3'%20height%3D'3'%20fill%3D'%2305060a'%20fill-opacity%3D'.92'%2F%3E%3C%2Fsvg%3E\")) 3 fill / calc(var(--px,3px)*3) stretch;}.ds-icon-btn{display:inline-grid;place-items:center;min-width:44px;height:44px;padding:0 10px;color:var(--ink,#f7f4ea);background:none;cursor:pointer;transition:color .12s;}.ds-icon-btn:hover{color:var(--pb,#f5a524);}.ds-icon-btn:active{transform:translateY(var(--px,3px));}.ds-icon-btn .ds-icon{display:block;height:auto;}"
    },
    {
      "name": "Stat box",
      "kind": "card",
      "refersTo": "stat-box",
      "description": "A framed Label over a tabular Title value; changes bump the value.",
      "html": "<div class=\"ds-stat\"><span class=\"ds-stat-label\">SCORE</span><b class=\"ds-stat-value\">1,520</b></div>",
      "css": ".ds-stat{border:calc(var(--px,3px)*3) solid transparent;border-image:var(--frame,url(\"data:image/svg+xml,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20width%3D'9'%20height%3D'9'%20viewBox%3D'0%200%209%209'%20shape-rendering%3D'crispEdges'%3E%3Cpath%20fill%3D'%233b6cf6'%20d%3D'M1%200h7v1H1zM0%201h1v7H0zM8%201h1v7H8zM1%208h7v1H1z'%2F%3E%3Cpath%20fill%3D'%23f7f4ea'%20d%3D'M1%201h7v1H1zM1%202h1v5H1zM7%202h1v5H7zM1%207h7v1H1z'%2F%3E%3Cpath%20fill%3D'%233b6cf6'%20d%3D'M2%202h5v1H2zM2%203h1v3H2zM6%203h1v3H6zM2%206h5v1H2z'%2F%3E%3Crect%20x%3D'3'%20y%3D'3'%20width%3D'3'%20height%3D'3'%20fill%3D'%2305060a'%20fill-opacity%3D'.92'%2F%3E%3C%2Fsvg%3E\")) 3 fill / calc(var(--px,3px)*3) stretch;}.ds-stat{display:flex;flex-direction:column;gap:6px;width:150px;padding:6px 10px 8px;color:var(--ink,#f7f4ea);font-family:'Press Start 2P',ui-monospace,monospace;}.ds-stat-label{font-size:10px;color:var(--ink-dim,#b7bbcc);letter-spacing:.04em;}.ds-stat-value{font-weight:400;font-size:16px;font-variant-numeric:tabular-nums;}"
    },
    {
      "name": "Lead meter",
      "kind": "custom",
      "refersTo": "lead-meter",
      "description": "Twenty 3-pixel pips split 10 / 10; the lead lights outward from the centre in win green (right) or lose coral (left).",
      "html": "<div class=\"ds-lead\"><i class=\"\"></i><i class=\"\"></i><i class=\"\"></i><i class=\"\"></i><i class=\"\"></i><i class=\"\"></i><i class=\"\"></i><i class=\"\"></i><i class=\"behind\"></i><i class=\"behind\"></i><i class=\"ahead\"></i><i class=\"ahead\"></i><i class=\"ahead\"></i><i class=\"\"></i><i class=\"\"></i><i class=\"\"></i><i class=\"\"></i><i class=\"\"></i><i class=\"\"></i><i class=\"\"></i></div>",
      "css": ".ds-lead{display:flex;gap:2px;}.ds-lead i{width:calc(var(--px,3px)*3);height:calc(var(--px,3px)*3);background:rgb(247 244 234/.12);transition:background-color .15s;}.ds-lead i:nth-child(10){margin-right:calc(var(--px,3px)*2);}.ds-lead i.ahead{background:var(--win,#7be08f);}.ds-lead i.behind{background:var(--lose,#ff6b7a);}"
    },
