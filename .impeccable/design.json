      "css": ".ds-plate{border:calc(var(--px,3px)*3) solid transparent;border-image:var(--frame,url(\"data:image/svg+xml,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20width%3D'9'%20height%3D'9'%20viewBox%3D'0%200%209%209'%20shape-rendering%3D'crispEdges'%3E%3Cpath%20fill%3D'%233b6cf6'%20d%3D'M1%200h7v1H1zM0%201h1v7H0zM8%201h1v7H8zM1%208h7v1H1z'%2F%3E%3Cpath%20fill%3D'%23f7f4ea'%20d%3D'M1%201h7v1H1zM1%202h1v5H1zM7%202h1v5H7zM1%207h7v1H1z'%2F%3E%3Cpath%20fill%3D'%233b6cf6'%20d%3D'M2%202h5v1H2zM2%203h1v3H2zM6%203h1v3H6zM2%206h5v1H2z'%2F%3E%3Crect%20x%3D'3'%20y%3D'3'%20width%3D'3'%20height%3D'3'%20fill%3D'%2305060a'%20fill-opacity%3D'.92'%2F%3E%3C%2Fsvg%3E\")) 3 fill / calc(var(--px,3px)*3) stretch;}.ds-plate{display:inline-block;margin:0;padding:8px 20px;font:400 16px/1.7 'Press Start 2P',ui-monospace,monospace;letter-spacing:.08em;color:var(--ink,#f7f4ea);}"
