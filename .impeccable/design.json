    {
      "name": "Menu option (current)",
      "kind": "button",
      "refersTo": "option",
      "description": "A bare-word menu option with its sub-line; the arrow cursor and B colour mark the current one (hover, focus and arrow keys all set it).",
      "html": "<button class=\"ds-option cur\" type=\"button\"><b style=\"font-weight:400\">VS AI</b><small>Race a bot on the same pieces.</small></button>",
      "css": ".ds-option{position:relative;display:flex;flex-direction:column;gap:8px;padding:12px 12px 12px calc(var(--px,3px)*10);text-align:left;color:var(--ink,#f7f4ea);font:400 16px/1.7 'Press Start 2P',ui-monospace,monospace;letter-spacing:.04em;background:none;border:0;cursor:pointer;width:100%;max-width:360px;}.ds-option small{font-size:10px;line-height:1.8;color:var(--ink-dim,#b7bbcc);letter-spacing:0;}.ds-option::before{content:\"\";position:absolute;left:calc(var(--px,3px)*2);top:14px;width:calc(var(--px,3px)*5);height:calc(var(--px,3px)*7);background:var(--pb,#f5a524);-webkit-mask:url(\"data:image/svg+xml,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20width%3D'5'%20height%3D'7'%20viewBox%3D'0%200%205%207'%20shape-rendering%3D'crispEdges'%3E%3Cpath%20d%3D'M0%200h1v7H0zM1%201h1v5H1zM2%202h1v3H2zM3%203h1v1H3z'%2F%3E%3C%2Fsvg%3E\") no-repeat center/contain;mask:url(\"data:image/svg+xml,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20width%3D'5'%20height%3D'7'%20viewBox%3D'0%200%205%207'%20shape-rendering%3D'crispEdges'%3E%3Cpath%20d%3D'M0%200h1v7H0zM1%201h1v5H1zM2%202h1v3H2zM3%203h1v1H3z'%2F%3E%3C%2Fsvg%3E\") no-repeat center/contain;opacity:0;transform:translateX(-8px);transition:transform .16s cubic-bezier(.16,1,.3,1),opacity .1s;}.ds-option:hover,.ds-option:focus-visible,.ds-option.cur{color:var(--pb,#f5a524);outline:none;}.ds-option:hover::before,.ds-option:focus-visible::before,.ds-option.cur::before{opacity:1;transform:none;animation:ds-nudge .8s steps(1) infinite .2s;}@keyframes ds-nudge{50%{translate:var(--px,3px) 0;}}@media (prefers-reduced-motion:reduce){.ds-option.cur::before,.ds-option:hover::before,.ds-option:focus-visible::before{animation:none;}}"
